# Copia a `.env` en la raíz del repo para personalizar valores locales.
# Uso: docker compose --env-file .env up --build

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=proyecto_novedades

# --- API (proyecto-novedades) ---
API_PORT=3000
JWT_SECRET=dev_jwt_secret_minimo_32_caracteres_local
JWT_EXPIRES_IN=8h
BCRYPT_COST=12
CORS_ORIGIN_DEV=http://localhost:5173
CORS_ORIGIN_PROD=
GOOGLE_CLIENT_ID=
GOOGLE_DOMINIO_PERMITIDO=uniautonoma.edu.co
# Mismo valor que GOOGLE_CLIENT_ID (login con botón Google)
STORAGE_TYPE=local

# --- Firebase (opcional) — ver docs/VARIABLES_ENTORNO.md ---
# FIREBASE_CONFIG_PATH=/run/secrets/firebase-admin.json
# FIREBASE_CREDENTIALS_HOST_PATH=./proyecto-novedades/secrets/firebase-admin.json

# --- Frontend (Vite) ---
WEB_PORT=5173
VITE_PROXY_TARGET=http://api:3000
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_HD=uniautonoma.edu.co
